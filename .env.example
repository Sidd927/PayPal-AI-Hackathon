# ─── PayPal (sandbox) ───────────────────────────────────────────────────────
# Create a sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
# Leave both empty to run in clearly-labelled simulation mode (no PayPal calls).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# From `npm run check:sandbox -- --register-webhook` (needs a public https APP_BASE_URL).
PAYPAL_WEBHOOK_ID=
# Optional. Email of a sandbox *Personal* account, used as Bluebird Café's address so you can log in and
# pay as the buyer. That account must be registered in a country OTHER THAN INDIA: PayPal refuses to send
# invoices to India-based recipients (406 INR_FOREIGN_CURRENCY_BLOCKED). The country is set when the sandbox
# account is created (Testing Tools → Sandbox Accounts → Create account → Country/Region); changing the email
# does not change it. Leave empty to address Bluebird to a fictional .example address instead.
DEMO_PAYER_EMAIL=

# ─── AI ─────────────────────────────────────────────────────────────────────
# Provider: gemini (default) | anthropic | none. With no key for the chosen provider, Unstuck runs in
# rules-only mode (clearly labelled in the UI). See docs/AI_PROVIDERS.md.
AI_PROVIDER=gemini
# Google Gemini (default). Free key: https://aistudio.google.com/apikey  (never commit a real key)
GEMINI_API_KEY=
# Leave empty for the default (gemini-3.5-flash-lite). `npm run verify:ai` checks the model exists for your key.
GEMINI_MODEL=
# Unstuck's pacing of Gemini HTTP attempts (retries included) per minute. Not Google's quota: check your limit in AI Studio.
GEMINI_MAX_RPM=10

# Anthropic Claude (optional; used only when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high — Claude diagnosis effort (payer chat always uses low for snappy replies)
ANTHROPIC_EFFORT=medium

# Unstuck's own cap on AI HTTP attempts per day (retries count), whichever provider. Not Google's quota.
AI_DAILY_CALL_LIMIT=500

# ─── App ────────────────────────────────────────────────────────────────────
# Public base URL; used in the payment-page links Unstuck puts into PayPal reminders.
APP_BASE_URL=http://localhost:3000
# SQLite file location. Default: node_modules/.cache/unstuck/unstuck.db (outside the dev server's file watcher).
DATABASE_PATH=
# Optional: protect the owner console with HTTP basic auth, e.g. maya:a-long-passphrase
OWNER_BASIC_AUTH=
# Force simulation even when PayPal credentials are present: simulation
UNSTUCK_MODE=
# Set to false to disable the "Reset demo" endpoint
ALLOW_DEMO_RESET=true

# ─── Agent scheduling (optional) ────────────────────────────────────────────
# A scheduler (e.g. Render cron job) can start agent runs with:
#   curl -X POST -H "Authorization: Bearer $AGENT_RUN_TOKEN" -H "Content-Type: application/json" -d '{}' $APP_BASE_URL/api/agent/run
AGENT_RUN_TOKEN=

# ─── AG Studio (Insights page) ──────────────────────────────────────────────
# Free 45-day trial key from ag-grid.com removes the trial watermark. Exposed to the browser by design.
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
